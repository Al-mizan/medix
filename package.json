{
  "name": "medix",
  "version": "1.0.0",
  "private": true,
  "description": "Medix - Digital Healthcare Platform Monorepo",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:backend": "pnpm --filter backend test",
    "test:frontend": "pnpm --filter frontend test",
    "docs:typedoc": "pnpm --filter backend docs:typedoc",
    "db:migrate": "pnpm --filter backend migrate",
    "db:migrate:deploy": "pnpm --filter backend migrate:deploy",
    "db:generate": "pnpm --filter backend generate",
    "db:studio": "pnpm --filter backend studio",
    "docker:dev": "docker compose -f docker-compose.dev.yaml up",
    "docker:dev:down": "docker compose -f docker-compose.dev.yaml down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yaml build",
    "sync:lockfiles": "pnpm --dir backend install --ignore-workspace --lockfile-only && pnpm --dir frontend install --ignore-workspace --lockfile-only"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
